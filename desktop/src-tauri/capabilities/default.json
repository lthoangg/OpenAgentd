{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for the main window.",
  "windows": ["main", "main-*"],
  "local": true,
  "remote": {
    "urls": [
      "http://localhost",
      "http://localhost:*",
      "http://127.*",
      "http://127.*:*",
      "http://10.*",
      "http://10.*:*",
      "http://172.*",
      "http://172.*:*",
      "http://192.168.*",
      "http://192.168.*:*",
      "https://*",
      "https://*:*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:webview:default",
    "core:app:default",
    "core:event:default",
    "core:resources:default",
    "dialog:default",
    "notification:default",
    "allow-show-desktop-notification",
    "opener:default",
    "log:default",
    "updater:default",
    "allow-secure-get-access-key",
    "allow-secure-set-access-key",
    "allow-secure-delete-access-key",
    "allow-request-voice-permissions",
    "allow-save-workspace-file",
    "allow-backend-health",
    "allow-backend-logs-path",
    "allow-app-backend-status",
    "allow-app-remove-backend-server",
    "allow-app-save-backend-server",
    "allow-app-use-external-backend",
    "allow-app-use-bundled-backend",
    "allow-app-new-window",
    "allow-reapply-window-chrome",
    "allow-app-stop-bundled-backend",
    "allow-set-tray-session",
    "allow-updater-check",
    "allow-updater-download",
    "allow-updater-install",
    "allow-updater-release-notes"
  ]
}
