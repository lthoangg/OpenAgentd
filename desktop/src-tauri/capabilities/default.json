{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for the main window and the macOS tray popup. IPC is granted to the app origin only (the bundled UI, or devUrl in debug builds).",
  "windows": [
    "main",
    "main-*",
    "tray-popup"
  ],
  "local": true,
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "core:window:allow-set-badge-count",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:webview:default",
    "core:app:default",
    "core:event:default",
    "core:resources:default",
    "dialog:default",
    "notification:default",
    "allow-show-desktop-notification",
    "opener:default",
    "log:default",
    "deep-link:default",
    "updater:default",
    "allow-secure-get-access-key",
    "allow-secure-set-access-key",
    "allow-secure-delete-access-key",
    "allow-save-workspace-file",
    "allow-backend-health",
    "allow-backend-logs-path",
    "allow-desktop-logs-path",
    "allow-app-backend-status",
    "allow-app-remove-backend-server",
    "allow-app-save-backend-server",
    "allow-app-use-external-backend",
    "allow-app-use-bundled-backend",
    "allow-app-new-window",
    "allow-app-stop-bundled-backend",
    "allow-app-network-access-status",
    "allow-app-set-network-access",
    "allow-app-network-access-key",
    "allow-app-set-network-access-key",
    "allow-preview-relay-open",
    "allow-preview-relay-close",
    "allow-set-tray-session",
    "allow-get-tray-usage-summary",
    "allow-tray-action",
    "allow-tray-fit",
    "allow-island-settings",
    "allow-island-update-settings",
    "allow-island-viewing",
    "allow-updater-check",
    "allow-updater-download",
    "allow-updater-install",
    "allow-updater-release-notes"
  ]
}
