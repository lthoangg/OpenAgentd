# openagentd environment overrides (non-secret, all optional)
#
# You normally need none of these. The build picks the mode and the paths:
#   installed app / agentd (release build)  →  production, ~/.local/share/openagentd/…
#   cargo run, make run, make dev (debug)    →  development, <repo>/.openagentd/dev/…
#
# Server settings live in server.yaml in the config dir (host, port, access key,
# cors_origins, allow_insecure_lan, log_level, file_log_level). Provider keys and
# OAuth logins live in credentials.yaml: add them in Settings → Providers or with
#   agentd auth codex                 # OAuth login (repeat with --add for a 2nd account)
#   agentd credentials import <file>  # import KEY=value lines from a dotenv file
#
# Set the variables below in the environment (shell profile, launchd/systemd unit,
# CI, Docker); the environment wins over server.yaml. A `.env` file in the config
# dir is still read in v3.32.0 but is deprecated; a `.env` in the directory the
# server starts in is never read. Names without the OPENAGENTD_ prefix (APP_ENV,
# API_PORT, LOG_LEVEL, DATABASE_URL, …) still work in v3.32.0, with a notice.

# -----------------------------------------------------------------------------
# Mode: production or development (anything else is an error)
# -----------------------------------------------------------------------------
# OPENAGENTD_ENV=production

# -----------------------------------------------------------------------------
# Server (these override server.yaml)
# -----------------------------------------------------------------------------
# OPENAGENTD_LOG_LEVEL=INFO
# OPENAGENTD_FILE_LOG_LEVEL=DEBUG
# Browser origins allowed besides the desktop/Tauri and loopback ones (JSON list
# or comma-separated). Without an access key, other origins are refused so a web
# page in your browser cannot drive the local server; ["*"] allows all.
# OPENAGENTD_CORS_ORIGINS=["https://example.com"]

# -----------------------------------------------------------------------------
# Paths (derived from the mode; set only to override)
# -----------------------------------------------------------------------------
# Irreplaceable user data (the SQLite database). Denied to agent fs tools.
#   production:  ~/.local/share/openagentd/      development: .openagentd/dev/data/
# OPENAGENTD_DATA_DIR=
# Configuration: agents/, skills/, server.yaml, settings.yaml, credentials.yaml.
#   production:  ~/.config/openagentd/           development: .openagentd/dev/config/
# OPENAGENTD_CONFIG_DIR=
# Logs, telemetry, PID file.
#   production:  ~/.local/state/openagentd/      development: .openagentd/dev/state/
# OPENAGENTD_STATE_DIR=
# Regeneratable caches.
#   production:  ~/.cache/openagentd/            development: .openagentd/dev/cache/
# OPENAGENTD_CACHE_DIR=
# Per-session agent workspaces.
#   production:  ~/.local/share/openagentd-workspace/   development: .openagentd/dev/workspace/
# OPENAGENTD_WORKSPACE_DIR=
# SQLite database (defaults to {OPENAGENTD_DATA_DIR}/openagentd.db).
# OPENAGENTD_DATABASE_URL=

# -----------------------------------------------------------------------------
# Providers that only need a base URL or a project
# -----------------------------------------------------------------------------
# ROUTER9_BASE_URL=http://localhost:20128/v1
# CLIPROXY_BASE_URL=http://localhost:8317/v1
# OLLAMA_BASE_URL=http://localhost:11434/v1
# Vertex AI (run: gcloud auth application-default login)
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
