{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for the mobile shell. IPC is granted to the app origin only (the bundled UI, or devUrl in debug builds): never to a server origin or a previewed page.",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "core:default",
    "core:webview:default",
    "core:app:default",
    "core:event:default",
    "core:window:allow-set-badge-count",
    "opener:default",
    "notification:default",
    "deep-link:default",
    "haptics:allow-impact-feedback",
    "haptics:allow-selection-feedback",
    "haptics:allow-notification-feedback",
    "haptics:allow-vibrate",
    "allow-secure-get-access-key",
    "allow-secure-set-access-key",
    "allow-secure-delete-access-key",
    "allow-app-backend-status",
    "allow-app-save-backend-server",
    "allow-app-use-external-backend",
    "allow-app-remove-backend-server",
    "allow-save-workspace-file",
    "allow-preview-relay-open",
    "allow-preview-relay-close",
    "allow-widget-update-snapshot",
    "allow-app-move-to-background",
    "allow-set-app-theme",
    "allow-share-text",
    "allow-pick-one",
    "allow-push-status",
    "allow-push-register",
    "allow-cloud-status",
    "allow-cloud-sign-in",
    "allow-cloud-join-invite",
    "allow-cloud-cancel",
    "allow-cloud-confirm-recovery",
    "allow-cloud-devices",
    "allow-cloud-pending",
    "allow-cloud-approve-begin",
    "allow-cloud-approve-confirm",
    "allow-cloud-approve-reject",
    "allow-cloud-invite-start",
    "allow-cloud-invite-poll",
    "allow-cloud-invite-add",
    "allow-cloud-invite-cancel",
    "allow-cloud-remove-device",
    "allow-cloud-sign-out",
    "allow-cloud-take-notification",
    "allow-cloud-open-computer",
    "allow-cloud-push-register",
    "allow-updater-check",
    "allow-updater-download",
    "allow-updater-install",
    "allow-updater-release-notes"
  ]
}
