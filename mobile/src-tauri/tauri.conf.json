{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenAgentd",
  "mainBinaryName": "OpenAgentdMobile",
  "version": "1.44.6",
  "identifier": "com.openagentd.mobile",
  "build": {
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "cwd": "../..",
      "script": "cd web && bun install --frozen-lockfile && bun run build"
    },
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenAgentd",
        "width": 390,
        "height": 844,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' http://127.0.0.1:* http://localhost:* https:",
        "connect-src": "'self' http: https: ws: ipc: https://ipc.localhost",
        "script-src": "'self' 'unsafe-inline' http://127.0.0.1:* http://localhost:*",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http: https:",
        "font-src": "'self' data:",
        "media-src": "'self' blob: http: https:",
        "frame-src": "'none'",
        "object-src": "'none'",
        "worker-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "copyright": "Copyright (c) 2026 OpenAgentd contributors",
    "shortDescription": "OpenAgentd mobile shell for remote API servers.",
    "longDescription": "OpenAgentd mobile embeds the shared Web UI and connects to a remote OpenAgentd API server.",
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
