workspace/
# Dev-mode XDG layout created by application startup. Treat the tree as generated:
#  - data/state/cache/memory/workspace/uploads = pure runtime, never tracked
#  - config/ = user-editable runtime configuration and generated agent profiles
# Ignore the dev runtime subtree but keep project-scoped `commands/`
# and `skills/` tracked. Git can only re-include children if the parent
# directory itself is not excluded, so do not ignore `.openagentd/` itself.
#
# Patterns without a leading slash match `.openagentd/` at any depth
# (e.g. the repo root and `desktop/src-tauri/.openagentd/` from desktop
# dev builds).
.openagentd/dev/
.openagentd/evals/
.openagentd/sessions/
.openagentd/browser-use/
**/.openagentd/cache/
**/.openagentd/config/
**/.openagentd/data/
**/.openagentd/dev/
**/.openagentd/evals/
**/.openagentd/memory/
**/.openagentd/sessions/
**/.openagentd/state/
**/.openagentd/wiki/
**/.openagentd/workspace/
.tests/

