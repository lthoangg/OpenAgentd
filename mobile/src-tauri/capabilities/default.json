{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for the mobile shell.",
  "windows": ["main"],
  "local": true,
  "remote": {
    "urls": [
      "http://localhost",
      "http://localhost:*",
      "http://127.*",
      "http://127.*:*",
      "http://10.*",
      "http://10.*:*",
      "http://172.16.*",
      "http://172.16.*:*",
      "http://172.17.*",
      "http://172.17.*:*",
      "http://172.18.*",
      "http://172.18.*:*",
      "http://172.19.*",
      "http://172.19.*:*",
      "http://172.20.*",
      "http://172.20.*:*",
      "http://172.21.*",
      "http://172.21.*:*",
      "http://172.22.*",
      "http://172.22.*:*",
      "http://172.23.*",
      "http://172.23.*:*",
      "http://172.24.*",
      "http://172.24.*:*",
      "http://172.25.*",
      "http://172.25.*:*",
      "http://172.26.*",
      "http://172.26.*:*",
      "http://172.27.*",
      "http://172.27.*:*",
      "http://172.28.*",
      "http://172.28.*:*",
      "http://172.29.*",
      "http://172.29.*:*",
      "http://172.30.*",
      "http://172.30.*:*",
      "http://172.31.*",
      "http://172.31.*:*",
      "http://192.168.*",
      "http://192.168.*:*",
      "https://*",
      "https://*:*"
    ]
  },
  "permissions": [
    "core:default",
    "core:webview:default",
    "core:app:default",
    "core:event:default",
    "opener:default",
    "notification:default",
    "haptics:allow-impact-feedback",
    "haptics:allow-vibrate",
    "allow-app-backend-status",
    "allow-app-save-backend-server",
    "allow-app-use-external-backend",
    "allow-app-remove-backend-server",
    "allow-save-workspace-file"
  ]
}
