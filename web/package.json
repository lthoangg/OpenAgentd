{
  "name": "openagentd-web",
  "private": true,
  "version": "3.49.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && bun run check:chunks && bun run check:budget",
    "check:chunks": "bun scripts/check-chunk-cycles.mjs",
    "check:budget": "bun scripts/check-bundle-budget.mjs",
    "build:analyze": "tsc -b && ANALYZE=1 vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint --type-aware -c .oxlintrc.json",
    "lint:fix": "oxlint --type-aware --fix -c .oxlintrc.json",
    "preview": "vite preview",
    "test": "bun test --parallel src/__tests__",
    "test:file": "bun test --parallel"
  },
