{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "unicorn", "typescript", "import"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["dist/**"],
  "rules": {
    "react/set-state-in-effect": "off",
    "react/refs": "off",
    "react/immutability": "off",
    "react/globals": "off",
    "react/purity": "off",
    "react/rules-of-hooks": "error",
    "import/no-cycle": "error",
    "typescript/no-explicit-any": "error",
    "no-restricted-globals": [
      "error",
      {
        "name": "fetch",
        "message": "Call the backend through src/api/, which owns backend URLs and auth injection."
      }
    ],
    "eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_"
      }
    ],
    "typescript/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_"
      }
    ],
    "unicorn/no-useless-fallback-in-spread": "off",
    "unicorn/no-useless-spread": "off",
    "typescript/no-useless-empty-export": "off",
    "typescript/unbound-method": "off",
    "typescript/no-base-to-string": "off",
    "typescript/no-floating-promises": "off",
    "typescript/no-meaningless-void-operator": "off",
    "typescript/no-redundant-type-constituents": "off"
  },
  "overrides": [
    {
      "files": ["src/__tests__/**", "scripts/*.bench.tsx"],
      "rules": {
        "react/rules-of-hooks": "off",
        "typescript/no-explicit-any": "off",
        "typescript/await-thenable": "off",
        "no-restricted-globals": "off"
      }
    },
    {
      "files": [
        "src/api/**",
        "src/components/settings/pages/settings.providers/credentialApi.ts",
        "src/components/FileViewerPanel.tsx",
        "src/hooks/useDeepLinkRouter.ts",
        "src/lib/server-probe.ts",
        "src/components/FileLightbox.tsx",
        "src/components/AgentChatView/helpers.ts",
        "src/components/WorkspacePanel/AttachmentTabView.tsx",
        "src/lib/tauri-download.ts"
      ],
      "rules": {
        "no-restricted-globals": "off"
      }
    }
  ]
}
